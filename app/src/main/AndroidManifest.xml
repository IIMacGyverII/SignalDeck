<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />   <!-- localhost socket to the companion recognizer, elevation lookup -->
    <!-- SignalDeck Web's Phone panel: the Wi-Fi link (signal, speed, band) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Scheduled operations start on the minute (SignalDeck grants this to itself with root; otherwise Android may delay them a little) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- steering-wheel talk as a self-managed call: the car's microphone, stopped by the car's hang-up / End -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />   <!-- coverage logging with the screen off -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />   <!-- recordings made by an earlier install / the module -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />   <!-- in-app updates from GitHub releases -->

    <!-- Android Auto: to tell whether it will show this app in the car (car/AutoTrust) and open its settings -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <!-- The stock radio apps, so their APK and version are visible to the package manager (Android 11+ package visibility) -->
        <package android:name="com.pri.prizeinterphone" />
        <package android:name="com.agold.intercom" />
        <package android:name="com.interphone" />
        <intent><action android:name="android.intent.action.APPLICATION_PREFERENCES" /></intent>
    </queries>

    <application
        android:name=".RadioApp"
        android:label="SignalDeck"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/AppTheme">

        <!-- Ulefone's radio audio class. On the stock ROM it is on the boot class path anyway; a custom ROM or GSI that
             gets it from a Magisk module ships it as a shared library, which only reaches an app that asks for it.
             Optional, so the app installs and runs on every phone (tester's report 2026-10-23, Armor 26 Ultra GSI). -->
        <uses-library android:name="android.os.PrizeTinyService" android:required="false" />

        <!-- The app's own language (Device → Language): appcompat stores it and applies it on Android 10–12 too -->
        <service android:name="androidx.appcompat.app.AppLocalesMetadataHolderService" android:enabled="false" android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>

        <!-- singleTask: the launcher icon, notifications, the widget and shares all bring the one open screen forward (onNewIntent)
             instead of stacking another copy, which also replayed the launch screen -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ShareLocationActivity" android:exported="true" android:label="Set channel location"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- shared channels: an SDCP1 code in text from any app, a SignalDeck file or a CHIRP CSV (preview before anything is added) -->
        <activity android:name=".ImportCodeplugActivity" android:exported="true" android:label="Import channels"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>
        </activity>
        <service android:name=".RadioService" android:exported="false" android:foregroundServiceType="microphone|location" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- Android Auto: the radio as a media app (browse channels and zones, now playing, next/previous, Scan, Talk) -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
        <!-- off by default (Device -> Full-screen Radio controls in the car): while it is enabled Android Auto lists only
             this entry and hides the media app, and a car that does not accept it is left with no way in and no sound -->
        <service android:name=".car.RadioCarAppService" android:exported="true" android:enabled="false" android:label="Radio controls" android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>
        <service android:name=".media.RadioMediaService" android:exported="true" android:label="SignalDeck">
            <intent-filter><action android:name="android.media.browse.MediaBrowserService" /></intent-filter>
        </service>
        <receiver android:name="androidx.media.session.MediaButtonReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MEDIA_BUTTON" /></intent-filter>
        </receiver>
        <receiver android:name=".CarMessages$Receiver" android:exported="false" />
        <receiver android:name=".Scheduler$Receiver" android:exported="false" />
        <receiver android:name=".RadioWidget" android:exported="false" android:label="Radio">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/radio_widget_info" />
        </receiver>
        <service android:name=".car.RadioCallService" android:exported="true" android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter><action android:name="android.telecom.ConnectionService" /></intent-filter>
        </service>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
