    <!-- History section when SignalDeck does not drive the radio yet. One line. -->
    <string name="channel_editor_history_no_service">Prenez la main sur la radio pour voir l’historique.</string>
    <!-- History section when it cannot be read; %1$s is the error. One line. -->
