        <item quantity="many">%1$d de talkgroups ajoutés : appuyez sur Enregistrer pour les conserver</item>
        <item quantity="other">%1$d talkgroups ajoutés : appuyez sur Enregistrer pour les conserver</item>
    </plurals>
    <!-- The same when the RX list is now full (32). One line. -->
    <plurals name="channel_editor_tg_added_full">
        <item quantity="one">%1$d talkgroup ajouté (la radio en accepte 32 au maximum) : appuyez sur Enregistrer pour conserver l’ajout</item>
        <item quantity="many">%1$d de talkgroups ajoutés (la radio en accepte 32 au maximum) : appuyez sur Enregistrer pour les conserver</item>
        <item quantity="other">%1$d talkgroups ajoutés (la radio en accepte 32 au maximum) : appuyez sur Enregistrer pour les conserver</item>
