    <string name="channel_editor_m17_dest_title">Destinataire M17</string>
    <!-- Toast when a tone is picked before its type. One line. -->
    <string name="channel_editor_tone_type_first">Choisissez d’abord CTCSS ou DCS dans le type de tonalité ci-dessus</string>
    <!-- Content description of a field's i button; %1$s is the field's label. Short. -->
