    <!-- Hint of the name field for a new talkgroup list. Short. -->
    <string name="channel_editor_tg_list_name">Nom de la liste</string>
    <!-- Dialog title: save the RX list under a name. Short. -->
    <string name="channel_editor_tg_save_title">Enregistrer la liste de talkgroups</string>
    <!-- Toast after saving a talkgroup list; %1$s is its name. Short. -->
    <string name="channel_editor_tg_saved">Liste « %1$s » enregistrée</string>
