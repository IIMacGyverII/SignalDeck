<?xml version="1.0" encoding="utf-8"?>
<!--
  Words used on many screens. One file per screen group (strings_<group>.xml); every string has a comment above it
  with its context and the space it has, for translators. Arguments are numbered (%1$s) so a translation can reorder
  them. Logs, diagnostics, report.json, file formats and anything sent on the air stay in code, in English.
-->
<resources>
    <!-- Button that closes a dialog without doing anything. Short (dialog button). -->
    <string name="common_cancel">Annuler</string>
    <!-- Button that keeps the changes made in a dialog or editor. Short (button). -->
    <string name="common_save">Enregistrer</string>
    <!-- Button that accepts a message or dialog. Short (button). -->
    <string name="common_ok">OK</string>
    <!-- Button that removes the item (a channel, zone, contact, recording…). Short (button). -->
    <string name="common_delete">Supprimer</string>
    <!-- Button that closes a sheet or dialog. Short (button). -->
    <string name="common_close">Fermer</string>
    <!-- Button that sends a message (APRS, DMR text, Winlink…). On the radio it transmits. Short (button). -->
    <string name="common_send">Envoyer</string>
    <!-- Button that puts off an offer (an update, a check) without saying no for good. Short (button). -->
    <string name="common_later">Plus tard</string>
    <!-- Button that goes on to the next step. Short (button). -->
    <string name="common_continue">Continuer</string>
    <!-- Button that empties a list or a field. Short (button). -->
    <string name="common_clear">Effacer</string>
    <!-- Button that starts something (a session, a net, a scan). Short (button). -->
    <string name="common_start">Démarrer</string>
    <!-- Button that stops what is running. Short (button). -->
    <string name="common_stop">Arrêter</string>
    <!-- Button that opens Android's share sheet. Short (button). -->
    <string name="common_share">Partager</string>
    <!-- Button that declines an offer for now. Short (button). -->
    <string name="common_not_now">Pas maintenant</string>
    <!-- Button that imports channels, contacts or a file. Short (button). -->
    <string name="common_import">Importer</string>
    <!-- Button that goes back one step. Short (button). -->
    <string name="common_back">Retour</string>
    <!-- Button that opens the editor for an item. Short (button). -->
    <string name="common_edit">Modifier</string>
    <!-- Button that adds a new item. Short (button). -->
    <string name="common_add">Ajouter</string>
    <!-- Button that finishes a task and closes it. Short (button). -->
    <string name="common_done">Terminé</string>
    <!-- State of a switch or feature that is running. Very short. -->
    <string name="common_on">Activé</string>
    <!-- State of a switch or feature that is not running. Very short. -->
    <string name="common_off">Désactivé</string>
</resources>
