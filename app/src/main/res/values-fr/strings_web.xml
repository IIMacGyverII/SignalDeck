<?xml version="1.0" encoding="utf-8"?>
<!--
  SignalDeck Web: the phone's replies to the browser pages (WebHost, WebServer). They show in the page as a toast (a
  short message at the bottom), an error line or a status line, unless a comment says otherwise. Toasts have room for
  one or two lines. The pages never compare these texts, so every one can be translated. The pages' own text is in
  assets/web/i18n/en.json.
-->
<resources>
    <!-- ==== general replies ==== -->
