    <string name="web_tx_off">Transmit from the web is off (phone: Device → SignalDeck Web)</string>
    <!-- Error: the action is locked because the phone is in Restricted mode (a mode the owner sets on the phone). -->
    <string name="web_restricted">That is turned off in Restricted mode</string>
